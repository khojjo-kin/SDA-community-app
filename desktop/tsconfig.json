{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "shared/*": [
        "../src/lib/*"
      ],
      "expo-crypto": [
        "./src/shims/expo-crypto.ts"
      ],
      "expo-file-system": [
        "./src/shims/expo-file-system.ts"
      ],
      "expo-image-manipulator": [
        "./src/shims/expo-image-manipulator.ts"
      ],
      "expo-video-thumbnails": [
        "./src/shims/expo-video-thumbnails.ts"
      ],
      "react-native-url-polyfill/auto": [
        "./src/shims/empty.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@supabase/supabase-js": [
        "./node_modules/@supabase/supabase-js"
      ],
      "@react-native-async-storage/async-storage": [
        "./src/shims/async-storage.ts"
      ],
      "expo-secure-store": [
        "./src/shims/secure-store.ts"
      ],
      "react-native": [
        "./src/shims/react-native.tsx"
      ],
      "react-native-webrtc": [
        "./src/shims/webrtc.ts"
      ],
      "react-native-color-matrix-image-filters": [
        "./src/shims/color-matrix.ts"
      ],
      "shared/calls": [
        "./src/types/shared-calls.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "../src/lib/api.ts",
    "../src/lib/store.ts",
    "../src/lib/types.ts",
    "../src/lib/theme.ts",
    "../src/lib/supabase.ts",
    "../src/lib/rtc.ts",
    "../src/lib/bible.ts",
    "../src/lib/sabbath-school.ts",
    "../src/lib/hymnal.ts",
    "../src/lib/filters.ts"
  ],
  "exclude": [
    "src/fake"
  ]
}
